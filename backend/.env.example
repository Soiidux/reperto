# Server
PORT=5000
NODE_ENV=development

# Database (MongoDB Atlas or local)
MONGODB_URI=mongodb://localhost:27017/reperto

# Auth — generate with: openssl rand -hex 32
JWT_SECRET=replace-with-a-64-character-random-hex-string
JWT_EXPIRY=15m

# Frontend origin allowed by CORS
CLIENT_ORIGIN=http://localhost:5173

# Cloudinary (profile image storage)
CLOUDINARY_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Email — Resend HTTP API (preferred; used first when RESEND_API_KEY is set)
# Free tier: ~3k emails/month. In dev, mail is sent from the shared
# onboarding@resend.dev sender domain until you add/verify your own domain.
RESEND_API_KEY=your-resend-api-key
RESEND_FROM=Reperto <you@yourdomain.com>

# Email — SMTP fallback (used only when RESEND_API_KEY is empty)
# Empty = dev console transport, so verification flows stay testable pre-deploy.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Reperto <no-reply@yourdomain.com>

# SMS (optional)
SMS_PROVIDER=
SMS_API_KEY=
SMS_URL=

# Clinic contact details shown in emails
CLINIC_PHONE=+91 98765 43210
CLINIC_EMAIL=care@yourclinic.com
